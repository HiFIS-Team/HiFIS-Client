# 환경변수 템플릿 — 복사해서 .env.local 로 만들고 값을 채운다.
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* 값은 빌드 시점에 번들로 인라인되므로,
# 값 변경 후엔 반드시 재빌드(npm run build) 필요.

# 백엔드 FastAPI Base URL
# 개발: http://localhost:8000  또는 http://<LAN IP>:8000 (다른 기기 테스트용)
# 운영: https://api.hifis.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
