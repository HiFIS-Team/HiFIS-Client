# 환경변수 템플릿 — 복사해서 .env.local 로 만들고 값을 채운다.
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* 값은 빌드 시점에 번들로 인라인된다.
# 운영 빌드는 .env.local 대신 명령 인라인으로 주입 권장 — 환경 분리 명확:
#   운영:  NEXT_PUBLIC_API_BASE_URL=https://api.hifis.app npm run build
#   개발:  npm run dev  (이 파일의 값 사용)

# 백엔드 FastAPI Base URL
# 개발: http://localhost:8000 또는 http://<LAN IP>:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 앱 환경 — 사이드바 버전 표시에서 dev/prod 구분에 사용.
# dev: 사이드바에 "v1.0.0 (dev)" 옅게 표시 / prod: "v1.0.0" 만
NEXT_PUBLIC_APP_ENV=dev
