# 환경변수 템플릿 — 복사해서 .env.local 로 만들고 값을 채운다.
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* 값은 빌드 시점에 번들로 인라인된다.
# 운영 빌드는 .env.local 대신 명령 인라인으로 주입 권장 — 환경 분리 명확:
#   운영:  NEXT_PUBLIC_API_BASE_URL=https://api.hifis.app npm run build
#   개발:  npm run dev  (이 파일의 값 사용)

# v1 백엔드 (HiFIS-Server, 레거시) Base URL — 아직 안 옮긴 어드민 페이지가 사용.
# 개발: http://localhost:8000 또는 http://<LAN IP>:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# v2 백엔드 (HiFIS-Server-V2) Base URL — v2 인증 · 문서함 · 결재 등이 사용.
# 개발: /api-v2 (next.config rewrites 로 localhost:8001 프록시) 또는 직접 http://localhost:8001
NEXT_PUBLIC_API_V2_BASE_URL=/api-v2

# 사내톡 WebSocket URL — 미지정 시 Base URL 로부터 파생 (프록시 경로면 window.origin + base + /ws/chat).
# dev 서버가 WS 프록시 안 하면 실제 백엔드 host 명시 권장.
# 예) 개발: ws://localhost:8001/ws/chat / 운영: wss://api.hifis.app/ws/chat
# NEXT_PUBLIC_API_V2_WS_URL=ws://localhost:8001/ws/chat

# 앱 환경 — 사이드바 버전 표시에서 dev/prod 구분에 사용.
# dev: 사이드바에 "v1.0.0 (dev)" 옅게 표시 / prod: "v1.0.0" 만
NEXT_PUBLIC_APP_ENV=dev
